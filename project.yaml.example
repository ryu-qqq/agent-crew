# agent-crew 소비 프로젝트 설정
# 이 파일을 소비 프로젝트의 .claude/project.yaml 로 복사해 값을 채운다.
# agent-crew 에이전트·스킬은 작업 첫 단계로 이 파일을 Read 하여 프로젝트 고유 값을 얻는다.

project:
  # 프로젝트 식별자. 시드 파일 prefix, wiki 영역 이름 등에 쓰인다.
  name: my-project
  # 한 줄 설명 (선택)
  description: ""
  # 백엔드 스택 식별자. 스택 특화 자산이 references/<stack>/ 팩을 고를 때 쓴다.
  # 예: java-spring. 미설정이면 스택 특화 권고 없이 동작한다.
  stack: java-spring

# ── 작업 추적 (jira-manager / notion-manager / engineering-os) ──
# 보통 jira / notion 중 하나만 enabled: true 로 둔다.
tracking:
  jira:
    enabled: false
    # Jira 프로젝트 키. 이 키로 이슈를 조회·갱신한다.
    projectKey: ABC
  notion:
    # Notion Engineering OS 또는 자체 Tasks DB로 작업을 추적하면 true
    enabled: true
    # convention: engineering-os — references/notion/engineering-os.md 필드 convention 사용
    # 미설정이면 notion-manager가 DB fetch만으로 freeform 처리
    convention: engineering-os
    # Engineering OS 허브 페이지 URL (선택 — 조회·안내용)
    hubPageUrl: ""
    # Tasks 데이터베이스 — collection:// URI 또는 Notion DB ID
    tasksDatabaseId: ""
    # Projects · Epics DB (relation 조회용, 선택)
    projectsDatabaseId: ""
    epicsDatabaseId: ""
    # DB 속성명이 convention과 다를 때 override (선택)
    fieldNames:
      status: "상태"
      title: "작업"
      taskId: "Task ID"
      wikiAdr: "Wiki ADR"
      commit: "Commit"
      priority: "우선순위"
      project: "프로젝트"
      epic: "Epic"
      dueDate: "마감일"

# ── 지식 축적 (journal-recorder / wiki-curator / wiki-lookup / journal) ──
knowledge:
  # vault : 외부 wiki 레포에 raw 시드 + 합성 wiki 페이지 (복리 모델, 권장)
  # in-repo : 향후 지원 예정 — 프로젝트 내부 docs/ 기반
  mode: vault

  vault:
    # wiki 레포의 절대 경로 (로컬 체크아웃)
    path: /absolute/path/to/wiki-repo
    # vault 내에서 이 프로젝트의 wiki 영역
    projectPath: wiki/projects/my-project
    # 컨벤션 등 프로젝트 공통 wiki 영역 (선택)
    conventionsPath: wiki/conventions
    # raw 시드 파일명 prefix — raw/<prefix>-<YYYY-MM-DD>-<유형>.md
    rawPrefix: my-project
    # vault 가 git 레포면 true — 갱신 후 commit 한다
    git: true

# ── 문서 저작 (notion-doc-writer / adr-author) ──────────────
# 스펙·PRD·설계 문서 등 "능동 산출 문서"를 Notion 에 쓸 때 설정한다.
# raw 시드 → 합성 지식베이스(vault wiki)는 위 knowledge 섹션 담당 — 역할이 다르다.
docs:
  notion:
    # 스펙·문서를 Notion 페이지로 저작하면 true
    enabled: false
    # 문서가 들어갈 Notion 상위 페이지 또는 데이터베이스 ID.
    parentId: ""
  # ADR(Architecture Decision Record) 저장 경로 — 소비 프로젝트 레포 내 상대 경로.
  # adr-author 가 이 경로에 NNNN-제목.md 형식으로 ADR 을 쓴다. 미설정 시 docs/adr.
  # Pivot·아키텍처 ADR은 wiki raw/ 를 쓰는 경우 knowledge.vault 와 engineering-os 루프를 따른다.
  adrPath: docs/adr

# ── agent-crew 동기화 정보 (agent-crew.lock 과 함께 관리) ──────
agentCrew:
  version: v0.4.0
